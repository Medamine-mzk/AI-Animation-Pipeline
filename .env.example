# Environment variables — copy to .env and fill in.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
#
# .env is gitignored. Never commit a filled-in copy.

# -----------------------------------------------------------------------------
# REQUIRED — speaker diarization
# -----------------------------------------------------------------------------
# Captions separate speakers with pyannote/speaker-diarization-community-1, a
# *gated* Hugging Face repository that cannot be downloaded anonymously. Without
# this token transcription still succeeds, but every line is attributed to a
# single speaker and the per-speaker colouring carries no information.
#
# Three steps, once per machine:
#   1. Free account at https://huggingface.co
#   2. Open  https://huggingface.co/pyannote/speaker-diarization-community-1
#      and click "Agree" to accept the conditions
#      (also https://huggingface.co/pyannote/segmentation-3.0 if you use it)
#   3. Create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# -----------------------------------------------------------------------------
# OPTIONAL — "AI Generate" mode of the 3D pipeline only
# -----------------------------------------------------------------------------
# Endpoint of an NVIDIA NIM (or OpenAI-compatible) server used to turn a prompt
# into a structured scene script. Leave empty for the WAV / manual modes.
# The captions feature never calls this.
NIM_MODELS=

# -----------------------------------------------------------------------------
# Not configurable by environment variable
# -----------------------------------------------------------------------------
# These are constants in the source, not env vars, so they cannot be changed
# without editing code:
#
#   ASR model          app/api/captions.py   ALLOWED_MODELS = tiny | base | small
#   Upload limit        app/pipeline/caption_source.py  180 s, 200 MB
#   Export             browser-side real-time capture -> server H.264 encode
#
# The ASR model can be chosen per request with the X-Caption-Model request
# header (tiny | base | small); the UI always sends the default, "small".
