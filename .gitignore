# =============================================================================
# Secrets — never commit these, not even by accident
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*

# =============================================================================
# Generated / run-time data
# =============================================================================
# Pipeline jobs. Caption jobs live in jobs_captions/ on purpose, so they can
# never surface in the 3D feature's "My Projects" list, which enumerates every
# directory under jobs/ that contains a meta.json.
jobs/
jobs_captions/
output/
*.tmp
*.part

# =============================================================================
# Third-party binaries and 3D payloads (~190 MB committed, ~3 GB untracked)
#
# These are downloaded, not authored. They are fetched by
#   tools/fetch-dependencies.ps1
# which the README points to. Vendoring them would make a clone ~3 GB and
# GitHub rejects any single file above 100 MB regardless.
# =============================================================================
tools/ffmpeg/
tools/rhubarb/
tools/blender/
node_modules/

# 3D models: ~1 GB of .glb backgrounds, avatars and debug renders.
assets/

# Stock icon / photo packs (~44 MB). The JSON manifests beside them are kept.
app/assets/icons/
app/assets/pixabay/

# Blender spike scripts' renders and probes
spike_out/
renders/

# =============================================================================
# User media — samples, uploads, source clips
# =============================================================================
media/2d/
media/3d/
media/uploads/
*.mp4
*.mov
*.webm
*.m4v
*.mkv
*.avi
*.wav
*.mp3
*.m4a
*.flac
*.zip
*.7z
*.fbx
*.glb
*.gltf
*.blend
*.blend1

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/
env/

# =============================================================================
# Logs and scratch files
# =============================================================================
*.log
*.bak
*.bak-*
*.bak.*
*.orig
*.rej
*.insert0
*.tmp
_bg.png
# stray zero-byte file from a shell redirect mistake
/0
serve.err.log
serve.out.log
sv.err.log
sv.out.log
uvicorn.*.log

# build caches that land beside their sources
*iconify_cache*.json

# =============================================================================
# Agents, editors, OS
# =============================================================================
.opencode/
tasks/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# =============================================================================
# Keep — these are authored, and stay tracked
# =============================================================================
!requirements.txt
!docs/screenshots/
# Local backups (tags, branches and bundles) � never part of the repo
_backups/
